{
  "name": "@miolos/games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./binairo": "./src/binairo/index.ts",
    "./crossword": "./src/crossword/index.ts",
    "./minesweeper": "./src/minesweeper/index.ts",
    "./nonogram": "./src/nonogram/index.ts",
    "./nonogram-colors": "./src/nonogram-colors/index.ts",
    "./queens": "./src/queens/index.ts",
    "./sudoku": "./src/sudoku/index.ts",
    "./sudoku-variants": "./src/sudoku-variants/index.ts",
    "./termo": "./src/termo/index.ts",
    "./termo-answers": "./src/termo-answers/index.ts",
    "./termo-free": "./src/termo-free/index.ts"
  },
  "scripts": {
    "generate:crossword": "node scripts/generate-crossword-lexicon.ts",
    "generate:nonogram": "node scripts/generate-nonogram-tones.ts",
    "generate:termo": "node scripts/generate-termo-words.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
