# Canonical origins (ADR-0013). Never hardcoded in code — env only.
NEXT_PUBLIC_SITE_URL=https://miolos.app
NEXT_PUBLIC_API_URL=https://api.miolos.app

# The web app reads today's PUBLISHED daily straight from the database
# through the published-predicate helper (ADR-0014 as extended by
# ADR-0028). Public published reads only — anything user-specific
# (sessions, completions, hint grants) goes through apps/api.
#
# This is the least-privilege `miolos_web` role's pooled connection string
# (#59, live since 2026-08-20): `select on daily_puzzles` and nothing else,
# under a name the Neon–Vercel integration does not manage. It is the
# SECOND enforcement point beside the module graph (`server-only` in
# src/db.ts, the narrowed root `@miolos/db` entry, the apps/web ESLint
# bans) — ADR-0026. src/db.ts reads this name only, with deliberately no
# fallback to the integration's variable (T-WEB-S290). Provision it with
# the scoped credential, never the integration's; `vercel env pull` on
# miolos-web supplies it.
WEB_DATABASE_URL=postgresql://miolos_web:password@host/db?sslmode=require
