# Canonical origins (ADR-0013). Never hardcoded in code — env only.
NEXT_PUBLIC_SITE_URL=https://miolos.app
NEXT_PUBLIC_API_URL=https://api.miolos.app

# The web app reads today's PUBLISHED daily straight from the database
# through the published-predicate helper (ADR-0014 as extended by
# ADR-0028). Public published reads only — anything user-specific
# (sessions, completions, hint grants) goes through apps/api.
#
# This is the integration-managed connection string, and it is NOT scoped:
# a least-privilege `miolos_web` role is designed and filed as #59, and is
# not in place. The MODULE GRAPH is the single enforcement point today —
# `server-only` in src/db.ts, the narrowed root `@miolos/db` entry, the
# apps/web ESLint bans. Do not provision this credential believing the
# database will refuse a `sessions` read; it will not.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
