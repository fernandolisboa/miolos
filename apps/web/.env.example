# Canonical origins (ADR-0013). Never hardcoded in code — env only.
NEXT_PUBLIC_SITE_URL=https://miolos.app
NEXT_PUBLIC_API_URL=https://api.miolos.app

# The web app reads today's PUBLISHED daily straight from the database
# through the published-predicate helper (ADR-0014 as extended by
# ADR-0028). Public published reads only, least-privilege role: anything
# user-specific — sessions, completions, hint grants — goes through
# apps/api, and the module graph enforces it (`server-only` in src/db.ts,
# the narrowed root `@miolos/db` entry, the apps/web ESLint bans).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
