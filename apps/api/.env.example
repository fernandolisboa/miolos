# The web app's origin, echoed as Access-Control-Allow-Origin.
# Unset means no CORS header is emitted at all.
WEB_ORIGIN=https://miolos.app

# Neon Postgres. Pulled via `vercel env pull --cwd apps/api`, never committed.
# DATABASE_URL is the pooled runtime connection; DATABASE_URL_UNPOOLED is for
# drizzle-kit migrations only (migrations must not go through the pooler).
DATABASE_URL=postgres://…
DATABASE_URL_UNPOOLED=postgres://…

# Bearer secret for GET /cron/publish. Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on cron invocations; the endpoint
# fails CLOSED when this is unset (401 — unlike WEB_ORIGIN's fail-open,
# an open publish endpoint would be a generation-loop DoS). Generate with
# `openssl rand -hex 32`, set via `vercel env add CRON_SECRET production`.
CRON_SECRET=…

# Resend API key for the magic-link transport (#21, ADR-0050). Create in
# the Resend dashboard (sending-only scope) after the miolos.app sending
# domain is verified; set via `vercel env add RESEND_API_KEY production`.
# Fails CLOSED when unset: POST /attach/request answers 503 before any
# side effect and GET /attach/state reports ineligible, so the whole
# attach flow stays dormant until the key exists.
RESEND_API_KEY=…

# Session cookie Domain (ADR-0022, plan 009 D10). Set to the apex in prod
# (miolos.app) so web and api subdomains share the cookie. Unset locally and
# on *.vercel.app previews (public-suffix: a shared Domain is unsettable
# there) — the cookie is then host-only. Secure is emitted when this is set
# OR NODE_ENV is production, so https previews still get a Secure cookie.
COOKIE_DOMAIN=miolos.app
